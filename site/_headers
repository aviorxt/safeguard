/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
/blocklists/*
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
/blocklists/report.json
  Cache-Control: no-cache, must-revalidate
/deployment.json
  Cache-Control: no-cache, must-revalidate
